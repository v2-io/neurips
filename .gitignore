.DS_Store
__pycache__/
*.pyc
.venv/
.obsidian/

# Build artifacts (per-paper out/ dirs)
0?-*/out/
00-test-paper/out/

# refs/ — citation system: entries + verifications + deny-list are tracked;
# PDFs are large + likely copyrighted; _emitted/ is generated artifact.
refs/pdfs/*
!refs/pdfs/.gitkeep
refs/_emitted/
