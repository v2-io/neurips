#!/usr/bin/env ruby
#
# bin/page-budget — main-text page count vs NeurIPS 9-page limit.
#
# NeurIPS 2026 caps the main content at 9 pages. References, appendices,
# and the Paper Checklist are unbudgeted and follow after. This script
# parses each paper's `<paper-dir>/.build/<manifest>/<manifest>.aux` (LaTeX
# writes the final paginated location of every \section / \appendix / \label
# there) and reports:
#
#   - the page main text ends on (one before the first appendix/references)
#   - overage vs the 9-page limit
#   - per-section breakdown for trim planning
#
# Usage:
#   bin/page-budget                                # all 0?-* paper dirs
#   bin/page-budget 02-unified-convergence-rl      # one paper
#   bin/page-budget --manifest full-paper          # different manifest stem
#
# Run after `bin/build <paper> <manifest>` — the .aux file is the input.
# Exits 0 always; this is a status reporter, not a CI gate.
#
# Design note. The earlier project (~/src/neurips2026/bin/page-budget) parsed
# `\newlabel` entries; this version uses `\@writefile{toc}{\contentsline ...}`
# instead because TOC entries already classify section vs appendix vs paragraph
# explicitly via their reference-target suffix (`section.N`, `appendix.A`,
# `section*.N` for unnumbered headings) — fewer heuristics, more direct.
#
# Bibliography-region sharpening. The original three-tier detection over-
# counts main-text by 1–2 pages when the bibliography sits between body and
# appendix and tier-2 ("References" TOC entry) doesn't fire (most natbib +
# unsrtnat configurations don't emit one). Patch: also count `\bibcite{...}`
# lines in the .aux; when tier-1 (first-appendix marker) is what landed and
# we can see `\bibcite` entries, subtract estimated bib pages
# (ceil(n_bibcites / entries_per_page)) from the main-text-end. The
# entries-per-page heuristic is matches-the-tool's-heuristic-friendly nature
# (an alternative — read hyperref's bibitem page anchors — only works under
# non-draft mode). Empirically ~30 entries/page in NeurIPS double-column-ish
# rendering; the constant is conservative-ish to avoid undercounting bib.

require "optparse"
require "open3"

ROOT  = Pathname.new(__dir__).parent.expand_path
LIMIT = 9

# `\contentsline {KIND}{INNER}{PAGE}{REF}\protected@file@percent }` — the
# inner can contain nested braces from `\numberline {N}`, so we anchor on the
# `\protected@file@percent` suffix and work back to find the trailing
# `{PAGE}{REF}` groups. Treats KIND, INNER as the prefix.
TOC_LINE_RE = /
  \\contentsline\s*
  \{(?<kind>\w+)\}
  \{(?<inner>.*)\}
  \{(?<page>\d+)\}
  \{(?<ref>[^}]+)\}
  \\protected@file@percent
/x

TocEntry = Struct.new(:kind, :inner, :page, :ref, keyword_init: true) do
  def appendix?    = ref.start_with?("appendix.")
  # Crude — distinguishes the `References` section heading from prose
  # references like "References to Strand 1 work".
  def references?  = inner.include?("References") && !inner.include?("References to")
  def section?     = kind == "section"

  def title = inner.sub(/\A\\numberline\s*\{[^}]+\}\s*/, "")

  def number
    if (m = inner.match(/\A\\numberline\s*\{([^}]+)\}/))
      m[1]
    else
      ""
    end
  end
end

def parse_aux(aux_path)
  entries = []
  aux_path.each_line do |line|
    next unless line.include?("\\contentsline")
    next unless (m = line.match(TOC_LINE_RE))

    entries << TocEntry.new(kind: m[:kind], inner: m[:inner], page: m[:page].to_i, ref: m[:ref])
  end
  entries
end

# Count `\bibcite{key}{...}` entries — proxy for "bibliography is part of
# this document." `\bibcite` lines are written when bibtex feeds back the
# resolved citation labels; one `\bibcite` per cited bib entry. Doesn't carry
# page info directly (that's the limitation), but the count drives the
# pages-per-bib-entries heuristic for the bibliography-region sharpening.
BIBCITE_RE = /^\\bibcite\{/

def count_bibcites(aux_path) = aux_path.each_line.count { |l| l.match?(BIBCITE_RE) }

# Heuristic: ~30 entries per bibliography page in NeurIPS-ish double-column
# rendering with `unsrtnat`. Conservative-ish (the cost of underestimating bib
# pages is undercounting main-text-end by a fraction of a page; the cost of
# overestimating is the opposite). Adjust if real-paper builds drift.
#
# Used as fallback only — `references_page_from_pdf` (below) extracts ground
# truth from the rendered PDF when pdftotext is available, which is more
# accurate than any entries-per-page heuristic. Real-paper density observed
# 16-26 entries/page in the 2026-05 sprint, too wide a range for a fixed
# constant to be reliably accurate.
BIB_ENTRIES_PER_PAGE = 30

# Match a "References" heading line in pdftotext -layout output. NeurIPS sty
# renders the body with LaTeX line numbers in the margin, so pdftotext sees
# "<line-number><spaces>References" rather than "References" alone. Match
# both forms (with or without the leading line-number marker).
REFERENCES_LINE_RE = /\A\s*(?:\d+\s+)?References\s*\z/

# Ground-truth the references-start page by parsing the rendered PDF directly.
# `pdftotext -layout` separates pages with form-feed (`\f`); we split on those
# and scan each page for a standalone "References" heading. Returns the page
# number (1-indexed) where References starts, or nil if pdftotext is unavailable
# or the heading isn't found.
#
# This bypasses the entries-per-page heuristic entirely when it works, and
# falls back to the heuristic on any failure path. The heuristic stays as
# defense-in-depth for environments without poppler / pdftotext.
def references_page_from_pdf(pdf_path)
  return nil unless pdf_path.exist?

  out, status = Open3.capture2("pdftotext", "-layout", pdf_path.to_s, "-")
  return nil unless status.success?

  out.split("\f").each_with_index do |page_text, i|
    page_text.each_line do |line|
      return i + 1 if line.match?(REFERENCES_LINE_RE)
    end
  end
  nil
rescue Errno::ENOENT
  # pdftotext not on PATH — fall back to heuristic.
  nil
end

# Find the page on which main text ends. Returns [end_page, marker_kind] where
# marker_kind is one of "appendix" / "references" / "appendix-minus-bib" /
# "last-section-fallback". Returns nil only if the paper has no TOC entries
# at all (still drafting).
#
# Detection tiers:
#   T1   first \contentsline {appendix.…} (the most common transition signal)
#   T2   first \contentsline whose inner contains "References" (firmer signal,
#        but most natbib + unsrtnat configurations don't emit one)
#   T1.5 (sharpening) when only T1 fires AND `\bibcite` entries are present,
#        subtract estimated bib pages from the appendix-start page so the
#        main-text-end excludes the bibliography sandwich. Surfaces as marker
#        "appendix-minus-bib" so the report explains the adjustment.
#   T3   fallback: estimate main-text-end as max(last-main-section-start,
#        total_pages - 2) when no explicit markers fire. Marker
#        "last-section-fallback".
def main_text_end(entries, aux_total_pages, n_bibcites = 0)
  marker = explicit_marker(entries)
  return adjusted_for_bib(marker, n_bibcites) if marker

  fallback_marker(entries, aux_total_pages)
end

# Return [first-marker-page, kind] from explicit appendix / references TOC
# entries, or nil if neither fired. Lower page wins when both are present.
def explicit_marker(entries)
  appendix_pages   = entries.select(&:appendix?).map(&:page)
  references_pages = entries.select(&:references?).map(&:page)
  candidates       = []
  candidates << [appendix_pages.min,   "appendix"]   unless appendix_pages.empty?
  candidates << [references_pages.min, "references"] unless references_pages.empty?
  candidates.min_by(&:first)
end

# T1.5 sharpening. When the explicit marker is the appendix (no References TOC
# entry fired) AND `\bibcite` count > 0, the appendix-start page actually
# trails an unbudgeted bib block. Subtract ceil(n_bibcites / entries_per_page)
# from the appendix-start to recover the true main-text-end.
def adjusted_for_bib(marker, n_bibcites)
  page, kind = marker
  if kind == "appendix" && n_bibcites.positive?
    bib_pages = (n_bibcites.to_f / BIB_ENTRIES_PER_PAGE).ceil
    adjusted  = page - 1 - bib_pages
    return [adjusted, "appendix-minus-bib(#{bib_pages}pp est. for #{n_bibcites} refs)"] if adjusted.positive?
  end
  [page - 1, kind]
end

# Tier 3 fallback. No explicit markers — estimate main-text-end as the larger
# of (last main-text section's start page) and (total pages - 2) on the
# assumption that bibliographies typically take 1-2 pages.
def fallback_marker(entries, aux_total_pages)
  main_sections = entries.select { |e| e.section? && !e.appendix? }
  return nil if main_sections.empty?

  last_section_page = main_sections.map(&:page).max
  fallback_end      = [last_section_page, aux_total_pages.to_i - 2].max
  [fallback_end, "last-section-fallback"]
end

# Total page count from the .aux: we look for the highest page number in any
# TOC entry. This isn't authoritative (the document may extend past the last
# TOC entry into bibliography), but it bounds the main-text estimate from below.
def aux_total_pages(entries) = entries.map(&:page).max || 0

def report(paper_dir, manifest)
  rel = paper_dir.relative_path_from(ROOT)
  aux = paper_dir / ".build" / manifest / "#{manifest}.aux"
  unless aux.exist?
    puts "  #{rel}: .build/#{manifest}/#{manifest}.aux not found — run `bin/build #{rel} #{manifest}` first"
    return
  end

  entries     = parse_aux(aux)
  n_bibcites  = count_bibcites(aux)
  result      = main_text_end(entries, aux_total_pages(entries), n_bibcites)
  unless result
    puts "  #{rel}/#{manifest}: no appendix or references markers in aux (still drafting?)"
    return
  end

  # T1.5+ refinement: when the marker is the heuristic appendix-minus-bib, try
  # to ground-truth the references-start page from the rendered PDF. Override
  # the heuristic with the actual page when pdftotext finds a clean match.
  end_page, marker = result
  if marker.start_with?("appendix-minus-bib") && (refs_page = references_page_from_pdf(paper_dir / ".build" / manifest / "#{manifest}.pdf"))
    end_page = refs_page - 1
    marker   = "references (from PDF, p#{refs_page})"
  end
  overage = end_page - LIMIT
  status  = overage.positive? ? "OVER" : "OK"
  sign    = overage.positive? ? "+" : ""

  puts "  #{rel}/#{manifest}: #{end_page}pp main-text  [#{status}: #{sign}#{overage} vs #{LIMIT}-pp]  (#{marker} starts p#{end_page + 1})"

  # Section progression — main + appendix sections in source order.
  sections = entries.select(&:section?)
  return if sections.empty?

  puts "    section progression:"
  sections.each do |s|
    classification = s.appendix? ? "appx" : "main"
    title          = s.title
    title          = "#{title[0, 57]}..." if title.length > 60
    puts "      §#{s.number.to_s.rjust(3)}  starts p#{s.page.to_s.rjust(3)}  #{classification}  #{title}"
  end
end

def paper_dir?(path) = path.directory? && (path / "meta.md").exist? && !path.glob("OUT.*.md").empty?

# Manifests for a paper-dir: every OUT.<stem>.md present (regardless of whether
# the build has run yet). report() handles the "no .aux yet" case with a "run
# bin/build first" notice rather than a hard error.
def manifests_for(paper_dir) = paper_dir.glob("OUT.*.md").map { |m| m.basename(".md").to_s.sub(/^OUT\./, "") }.sort

def main
  manifest_filter = nil
  OptionParser.new do |o|
    o.banner = <<~USAGE
      usage: bin/page-budget [<paper-dir>...] [--manifest STEM]

      Reports main-text page count vs NeurIPS #{LIMIT}-pp limit using each
      paper's <paper-dir>/.build/<manifest>/<manifest>.aux. Run `bin/build` first.

      With no args: cwd-aware. If cwd is a paper-dir, reports on its manifests.
      Otherwise reports on every paper-dir at the umbrella (matches OUT.*.md +
      meta.md presence — same heuristic bin/build uses).

      With --manifest STEM: only report on that stem (per paper-dir if multi).
    USAGE
    o.on("--manifest STEM", "restrict to a specific manifest stem") { |s| manifest_filter = s }
  end.parse!

  targets =
    if !ARGV.empty?
      ARGV.map { |t| Pathname.new(t).directory? ? Pathname.new(t).expand_path : (ROOT / t).expand_path }
    elsif paper_dir?(Pathname.pwd)
      [Pathname.pwd]
    else
      Dir.glob("#{ROOT}/[0-9][0-9]-*").map { |d| Pathname.new(d) }.select { |p| paper_dir?(p) }.sort
    end

  if targets.empty?
    warn "no paper-dirs found (looked for [0-9][0-9]-* with meta.md + OUT.*.md)"
    exit 1
  end

  puts "# Main-text page budget vs NeurIPS #{LIMIT}-page limit"
  puts

  targets.each do |p|
    unless paper_dir?(p)
      puts "  #{p}: not a paper-dir (no meta.md or no OUT.*.md)"
      next
    end

    stems = manifest_filter ? [manifest_filter] : manifests_for(p)
    if stems.empty?
      puts "  #{p.basename}: no manifests"
      next
    end
    stems.each { |stem| report(p, stem) }
    puts
  end
end

main if $PROGRAM_NAME == __FILE__
