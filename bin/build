#!/usr/bin/env ruby
#
# bin/build — assemble a paper from an OUT.*.md manifest into a NeurIPS-formatted PDF.
#
# Usage:
#   bin/build <paper-dir> [manifest-stem]
#
#   <paper-dir>      e.g., 00-test-paper, 01-tragedy-confident-agent
#   [manifest-stem]  defaults to "test" (reads OUT.test.md). Reads OUT.<stem>.md.
#
# Phase A scope: read meta.md (YAML frontmatter + abstract), parse the OUT.*.md
# assembly manifest, render each segment via a kramdown→LaTeX pipeline that
# routes Obsidian callouts (> [!theorem] / [!lemma] / etc.) to amsthm
# environments, [[#^anchor]] cross-refs to \Cref{anchor}, [!table] callouts to
# \begin{table}+caption+label+tabular, [!note]/[!todo]/[!info]/[!warning]/[!tip]
# to nothing (stripped). Splice into common/neurips_2026.tex template, run
# lualatex twice, output to <paper-dir>/out/<stem>.pdf.
#
# Architecture:
#   * Kramdown::Parser::NeurIPS — parser-level extension. Recognizes the
#     Obsidian callout pattern (`> [!type] title ^anchor`) at tokenize time
#     and stores type / title / anchor as attributes on the resulting
#     blockquote element. Same trick for header-trailing `^anchor`. Adds a
#     single-dollar inline-math span parser ($x$) since upstream kramdown
#     only recognizes $$...$$. Marker extraction runs as a *block* parser
#     (before any span parsing), so titles can contain $math$ without
#     fragmenting the marker into text-node soup.
#   * Kramdown::Converter::NeurIPS — converter consumes the pre-extracted
#     attributes (no regex digging through text nodes) and emits LaTeX.
#
# Raw TeX passes through unmodified — backslash sequences, environments, and
# braces are author-intentional LaTeX. Only %, &, _, #, ~, ^ are escaped (these
# are LaTeX-special but commonly used in prose with non-LaTeX meaning).
#
# Lint findings are collected as a side effect of AST traversal and printed
# at the end. Build does not auto-fix; --strict will fail on lint findings
# (deferred until Phase B).

require "kramdown"
require "kramdown/parser/kramdown"
require "yaml"
require "fileutils"
require "open3"

ROOT       = Pathname.new(__dir__).parent.expand_path
COMMON_DIR = ROOT / "common"
TEMPLATE   = COMMON_DIR / "neurips_2026.tex"

# ─────────────────────────────────────────────────────────────────────────────
# Custom kramdown parser — extracts callout markers and header anchors at
# parse time so they reach the converter as element attributes (rather than
# fragments of text-node soup that span parsing could shred).
# ─────────────────────────────────────────────────────────────────────────────

class Kramdown::Parser::NeurIPS < Kramdown::Parser::Kramdown
  # An Obsidian-style callout is a blockquote whose first non-whitespace
  # content is `[!type]` (optionally followed by `+` or `-` for fold state).
  # We claim those before the standard :blockquote parser sees them.
  CALLOUT_START   = /^#{OPT_SPACE}>[ \t]*\[!(?<type>\w+)\][+-]?/
  MARKER_LINE     = /\A\[!(?<type>\w+)\][+-]?[ \t]*(?<rest>.*?)\s*(?:\n|\z)/m
  MARKER_REST     = /\A(?<title>.*?)(?:\s+\^(?<anchor>[\w-]+))?\s*\z/
  HEADER_ANCHOR   = /\A(?<text>.*?)\s+\^(?<anchor>[\w-]+)\s*\z/

  # Single-dollar inline math. Upstream kramdown only recognizes $$...$$, so
  # plain `$x$` would otherwise leak through unparsed. The lookarounds keep
  # us out of $$...$$'s lane (handled by upstream :inline_math).
  SINGLE_DOLLAR_MATH = /(?<!\$)\$(?!\$)([^$\n]+?)\$(?!\$)/

  def initialize(source, options)
    super
    unless @block_parsers.include?(:callout)
      bq_idx = @block_parsers.index(:blockquote) || 0
      @block_parsers.insert(bq_idx, :callout)
    end
    @span_parsers.unshift(:single_dollar_math) unless @span_parsers.include?(:single_dollar_math)
  end

  def parse_single_dollar_math
    line     = @src.current_line_number
    @src.pos += @src.matched_size
    @tree.children << Element.new(:math, @src[1].strip, nil, category: :span, location: line)
  end
  define_parser(:single_dollar_math, SINGLE_DOLLAR_MATH, "\\$")

  # Slurp the contiguous `> ...` lines (same algorithm as parse_blockquote),
  # then peel off the marker line, attach (type / title / anchor) to the
  # blockquote element as attributes, and recurse on the remainder.
  #
  # rubocop:disable Naming/PredicateMethod -- kramdown's parse_* protocol
  # returns true/false to signal "claimed the input" vs "passed"; matching
  # that contract is more important than the boolean-method naming convention.
  def parse_callout
    start_line = @src.current_line_number
    raw        = @src.scan(self.class::PARAGRAPH_MATCH)
    raw << @src.scan(self.class::PARAGRAPH_MATCH) until @src.match?(self.class::LAZY_END)
    raw.gsub!(self.class::BLOCKQUOTE_START, "")

    marker = raw.match(MARKER_LINE)
    return false unless marker

    type     = marker[:type].downcase
    title    = nil
    anchor   = nil
    cols     = nil
    rest     = marker[:rest].to_s
    # Trailing key="value" attributes get peeled off before the title/anchor
    # match. Currently only cols="..." (a tabularx column spec) is recognized
    # — used by [!table] callouts whose default tabular overflows \textwidth.
    # Keeping the extraction generic makes it cheap to add width=, rotate=,
    # etc. later without re-touching the title-anchor regex.
    if (cm = rest.match(/\s+cols="(?<cols>[^"]+)"\s*\z/))
      cols = cm[:cols]
      rest = rest[0...cm.begin(0)]
    end
    if !rest.empty? && (rm = rest.match(MARKER_REST))
      title  = rm[:title].to_s.strip
      title  = nil if title.empty?
      anchor = rm[:anchor]
    end
    body = raw[marker[0].length..]

    el = new_block_el(:blockquote, nil, nil, location: start_line)
    el.attr["data-callout-type"]   = type
    el.attr["data-callout-title"]  = title  if title
    el.attr["data-callout-anchor"] = anchor if anchor
    el.attr["data-callout-cols"]   = cols   if cols
    @tree.children << el
    parse_blocks(el, body)
    true
  end
  # rubocop:enable Naming/PredicateMethod
  define_parser(:callout, CALLOUT_START)

  # Headers may carry a trailing `^anchor` (Obsidian block-reference syntax).
  # Override add_header to peel that off before the text becomes a child node;
  # we expose it as the data-header-anchor attribute for the converter.
  def add_header(level, text, id)
    anchor = nil
    if (m  = text.match(HEADER_ANCHOR))
      text   = m[:text]
      anchor = m[:anchor]
    end
    super
    return unless anchor

    @tree.children.last.attr["data-header-anchor"] = anchor
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Custom kramdown→LaTeX converter
# ─────────────────────────────────────────────────────────────────────────────

class Kramdown::Converter::NeurIPS < Kramdown::Converter::Latex
  # Characters we still escape in body text. We deliberately exclude
  # backslash, braces, and dollar — those are author-intentional LaTeX
  # (raw-TeX passthrough policy). The included characters are LaTeX-special
  # but commonly meant literally in prose.
  ESCAPE_MAP = {
    "%" => "\\%",
    "&" => "\\&",
    "_" => "\\_",
    "#" => "\\#",
    "~" => "\\textasciitilde{}",
    "^" => "\\textasciicircum{}"
  }.freeze
  ESCAPE_RE = /[%&_#~^]/

  # Codespans (backtick-wrapped inline content) are the escape hatch for
  # literal LaTeX characters — raw-TeX passthrough doesn't apply here. Author
  # writing `\Cref{thm-main}` inside backticks means "render the literal
  # string `\Cref{thm-main}`", not "execute the cleveref command." So we
  # apply the FULL escape inside codespans (backslash, braces, dollar, plus
  # everything in ESCAPE_MAP).
  CODESPAN_ESCAPE_MAP = ESCAPE_MAP.merge(
    "\\" => "\\textbackslash{}",
    "{"  => "\\{",
    "}"  => "\\}",
    "$"  => "\\$"
  ).freeze
  CODESPAN_ESCAPE_RE = /[\\{}$%&_#~^]/

  # Obsidian-callout types that map to amsthm-style numbered environments.
  # All share a single counter via amsthm's optional-counter mechanism.
  THEOREM_LIKE = %w[
    theorem lemma corollary proposition conjecture claim hypothesis
    definition remark
  ].freeze

  # Callout types that consume the body but emit no LaTeX — authoring
  # sidebars, working notes, drafting reminders.
  STRIP_LIKE = %w[note todo info warning tip].freeze

  # Cross-reference pattern (Obsidian wikilink for block references).
  CREF_PATTERN = /\[\[#\^([\w-]+)\]\]/

  # Trailing ` {-}` after a heading marks it unnumbered (Pandoc-style).
  HEADER_UNNUMBERED = /\s*\{-\}\s*\z/

  # ── Escape policy ────────────────────────────────────────────────────────

  # Override the inherited escape — passthrough \, {, }, $; resolve cross-refs
  # at the text level before the special-character escape pass.
  # Cross-ref router: anchors prefixed `eq-` render as \eqref{} (parenthesized
  # number, AUTHORING §1.7 convention); all other anchors use \Cref{} which
  # cleveref types automatically (Theorem N / Lemma N / Section N / etc.).
  def escape(str)
    str
      .gsub(CREF_PATTERN) do
        anchor = Regexp.last_match(1)
        anchor.start_with?("eq-") ? "\\eqref{#{anchor}}" : "\\Cref{#{anchor}}"
      end
      .gsub(ESCAPE_RE, ESCAPE_MAP)
  end

  # Full-escape variant for codespan content. See CODESPAN_ESCAPE_MAP comment.
  def codespan_escape(str) = str.gsub(CODESPAN_ESCAPE_RE, CODESPAN_ESCAPE_MAP)

  # ── Element converters ───────────────────────────────────────────────────

  def convert_codespan(el, _opts) = "\\texttt{#{codespan_escape(el.value)}}"

  # Kramdown's link parser eats `[[#^anchor]](text)` as `[label](url)` because
  # `]]` immediately followed by `(` matches the standard link syntax. By the
  # time `escape` sees text, the wikilink has already been parsed into an :a
  # element with href="text" and inner content "[#^anchor]". Catch it here
  # and re-emit as the cross-reference + parenthesized text the author meant.
  CONVERT_A_WIKILINK_RE = /\A\[#\^([\w-]+)\]\z/

  def convert_a(el, opts)
    # Inspect the unescaped text of the link's first child (not `inner(el, opts)`
    # which has already been through escape() with `#` and `^` rewritten).
    raw   = el.children.first&.type == :text ? el.children.first.value : ""
    if (m = raw.match(CONVERT_A_WIKILINK_RE))
      anchor = m[1]
      cref   = anchor.start_with?("eq-") ? "\\eqref{#{anchor}}" : "\\Cref{#{anchor}}"
      "#{cref}(#{el.attr['href']})"
    else
      super
    end
  end

  # Kramdown auto-wraps standalone-image paragraphs in `\begin{figure}\begin
  # {center}...\caption{alt}\end{center}\end{figure}`. Our `[!figure]` callout
  # is the canonical figure wrapper (carries the caption / label / centering),
  # so we suppress the auto-wrap and just emit the \includegraphics — let the
  # callout do the figure shaping. Bare `![alt](path)` outside a `[!figure]`
  # callout therefore renders as a plain inclusion; authors wanting a numbered
  # figure use the callout form per AUTHORING §1.5.
  def convert_standalone_image(_el, _opts, img) = img

  # Paragraph-leading bold-then-period — the academic-prose `**Two regimes.**
  # body...` shape — auto-converts to `\paragraph{Two regimes} body...` per
  # AUTHORING.md §1.9. Detection: rendered paragraph that starts with
  # \textbf{...}. with period inside the brace, followed by whitespace.
  #
  # Limited to top-level paragraphs (parent is :root). Paragraphs inside list
  # items, blockquotes, table cells, callouts, etc. would break LaTeX's
  # structural hierarchy if rewritten as \paragraph{}.
  PARAGRAPH_HEADING_RE = /\A\\textbf\{([^}]+?)\.\}\s*/

  # Trailing `^anchor` after a bold-prefix paragraph heading — kramdown's escape
  # pass turns the `^` into `\textasciicircum{}` and the rest as text. The
  # anchor doesn't actually work as a cleveref label (\paragraph{} has no
  # counter), so leaving it in body text shows up as literal `^anchor` noise
  # in the PDF. Strip it here and emit a lint warning per AUTHORING §1.9 —
  # author should use a callout or heading anchor instead.
  PARAGRAPH_ANCHOR_NOISE_RE = /\A(\\paragraph\{[^}]*\}\s*)\\textasciicircum\{\}([\w-]+)\s*/

  def convert_p(el, opts)
    rendered = super
    return rendered unless opts[:parent]&.type == :root

    rendered = rendered.sub(PARAGRAPH_HEADING_RE) { "\\paragraph{#{Regexp.last_match(1)}} " }
    rendered.sub(PARAGRAPH_ANCHOR_NOISE_RE) do
      anchor = Regexp.last_match(2)
      warning("`^#{anchor}` after bold-prefix paragraph heading — \\paragraph{} cannot be cross-referenced; use a callout (`> [!type] ... ^#{anchor}`) or a heading anchor (`### Title ^#{anchor}`) instead. AUTHORING §1.9.")
      Regexp.last_match(1)
    end
  end

  # Lint rule §B1: manual heading numbering ("## 3. Title", "### 3.1 Subtitle")
  # violates AUTHORING §1.8 — LaTeX numbers automatically. Warn so migration
  # agents see these and strip during their pass.
  MANUAL_HEADING_NUMBER_RE = /\A(?:\d+\.)+\d*\s+/

  def convert_header(el, opts)
    raw_title = inner(el, opts)
    starred   = false
    if raw_title.match?(HEADER_UNNUMBERED)
      raw_title = raw_title.sub(HEADER_UNNUMBERED, "")
      starred   = true
    end
    warning("manual heading numbering — strip per AUTHORING §1.8: #{raw_title.inspect}") if raw_title.match?(MANUAL_HEADING_NUMBER_RE)
    cmd     = header_command(el.options[:level])
    anchor  = el.attr["data-header-anchor"]
    result  = "\\#{cmd}#{'*' if starred}{#{raw_title.strip}}\n"
    result << "\\label{#{anchor}}\n" if anchor && !starred
    result << "\n"
    result
  end

  # Lint rule §B3: manual \tag{N} in display math violates AUTHORING §1.7
  # (anchored equations + [[#^eq-name]] cross-refs are the convention).
  # Warn at conversion time so migration agents see them.
  MANUAL_TAG_RE = /\\tag\*?\{[^}]+\}/

  def convert_math(el, opts)
    if el.value.match?(MANUAL_TAG_RE)
      warning("manual \\tag{} in math — use ^eq-anchor + [[#^eq-anchor]] per AUTHORING §1.7: #{el.value.lines.first.strip.inspect}")
    end

    anchor = el.attr["data-eq-anchor"]
    return super unless anchor

    inner = el.value
    if inner.include?("\\begin{aligned}")
      aligned_with_label = inner
                           .sub("\\begin{aligned}", "\\begin{align}\n\\label{#{anchor}}")
                           .sub("\\end{aligned}", "\\end{align}")
      "\n#{aligned_with_label}\n"
    else
      "\n\\begin{equation}\n#{inner}\n\\label{#{anchor}}\n\\end{equation}\n"
    end
  end

  def convert_blockquote(el, opts)
    type = el.attr["data-callout-type"]
    return super unless type
    return "" if STRIP_LIKE.include?(type)

    marker = {
      title:  escape_title(el.attr["data-callout-title"]),
      anchor: el.attr["data-callout-anchor"],
      cols:   el.attr["data-callout-cols"]
    }
    body = inner(el, opts).strip

    case type
    when *THEOREM_LIKE then render_theorem_like(type, marker, body)
    when "proof"       then render_proof(marker, body)
    when "table"       then render_table_callout(marker, body)
    when "figure"      then render_figure_callout(marker, body)
    when "quote"       then "\\begin{quote}\n#{body}\n\\end{quote}\n\n"
    else
      warning("unknown callout type: [!#{type}] — passing through as plain blockquote")
      super
    end
  end

  # convert_table is invoked both at top level and inside [!table] callouts.
  # We always emit just the tabular; the [!table] callout supplies the
  # \begin{table}\caption\label{}\centering wrapper.
  def convert_table(el, opts)
    alignments = el.options[:alignment].map { |a| ALIGN_MAP[a] || "l" }
    out        = "\\begin{tabular}{#{alignments.join}}\n"
    out << "\\toprule\n"
    out << inner(el, opts)
    out << "\\bottomrule\n"
    out << "\\end{tabular}\n"
    out
  end

  ALIGN_MAP = { left: "l", right: "r", center: "c", default: "l" }.freeze

  def convert_thead(el, opts) = "#{inner(el, opts)}\\midrule\n"
  def convert_tbody(el, opts) = inner(el, opts)
  def convert_tfoot(el, opts) = inner(el, opts)

  def convert_tr(el, opts)
    cells = el.children.map { |c| inner(c, opts).strip }
    "#{cells.join(' & ')} \\\\\n"
  end

  def convert_td(el, opts) = inner(el, opts)

  # ── Helpers ──────────────────────────────────────────────────────────────

  private

  # Title strings (callout titles, header text) live outside the kramdown
  # span-parsed AST, so Cref substitution and special-character escaping
  # need explicit application here. Math regions ($...$ and $$...$$) are
  # passed through verbatim — `^` and `_` are operators there, not text.
  def escape_title(str)
    return nil if str.nil?

    out   = +""
    parts = str.split(/(\$\$[^$]*\$\$|\$[^$\n]+?\$)/)
    parts.each do |part|
      out << if part.start_with?("$")
               part
             else
               part.gsub(CREF_PATTERN) { "\\Cref{#{Regexp.last_match(1)}}" }.gsub(ESCAPE_RE, ESCAPE_MAP)
             end
    end
    out
  end

  def header_command(level)
    case level
    when 1, 2 then "section"
    when 3    then "subsection"
    when 4    then "subsubsection"
    else           "paragraph"
    end
  end

  def render_theorem_like(env, marker, body)
    out  = "\\begin{#{env}}"
    out << "[#{marker[:title]}]" if marker[:title]
    out << "\n"
    out << "\\label{#{marker[:anchor]}}\n" if marker[:anchor]
    out << body
    out << "\n\\end{#{env}}\n\n"
    out
  end

  def render_proof(marker, body)
    out  = +"\\begin{proof}"
    out << "[#{marker[:title]}]" if marker[:title]
    out << "\n"
    out << body
    out << "\n\\end{proof}\n\n"
    out
  end

  # When the [!table] marker carries a `cols="..."` attribute (LaTeX column
  # spec — `l`, `c`, `r`, `X`, `p{...}`), substitute the kramdown-emitted
  # tabular block with tabularx of \textwidth. The `X` column type wraps
  # long cell content within a width-distributed column; this rescues wide
  # tables (multi-clause prose cells, classification matrices) whose default
  # `l...l` tabular overflowed the NeurIPS textwidth and truncated columns.
  # See AUTHORING §1.4. Default (no cols=) preserves the natural-width
  # tabular behavior — narrow tables shouldn't pay the tabularx tax.
  def render_table_callout(marker, body)
    if marker[:cols]
      body = body
             .sub(/\\begin\{tabular\}\{[^}]*\}/, "\\begin{tabularx}{\\textwidth}{#{marker[:cols]}}")
             .sub(/\\end\{tabular\}/, "\\end{tabularx}")
    end
    out  = +"\\begin{table}[h]\n"
    out << "  \\centering\n"
    out << "  \\caption{#{marker[:title]}}\n" if marker[:title]
    out << "  \\label{#{marker[:anchor]}}\n"  if marker[:anchor]
    out << body
    out << "\n\\end{table}\n\n"
    out
  end

  def render_figure_callout(marker, body)
    out  = +"\\begin{figure}[h]\n"
    out << "  \\centering\n"
    out << body
    out << "\n  \\caption{#{marker[:title]}}\n" if marker[:title]
    out << "  \\label{#{marker[:anchor]}}\n"    if marker[:anchor]
    out << "\\end{figure}\n\n"
    out
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Manifest & meta parsing
# ─────────────────────────────────────────────────────────────────────────────

class Manifest
  Row = Struct.new(:section, :type, :slug, :path, :title, :stage, keyword_init: true)

  attr_reader :rows

  def initialize(manifest_path)
    @path = manifest_path
    @rows = parse
  end

  private

  def parse
    rows  = []
    state = :outside
    @path.each_line do |line|
      next unless line.start_with?("|")

      cells = parse_row(line)
      next unless cells

      case state
      when :outside       then state = :header
      when :header        then state = (separator?(cells) ? :data : :outside)
      when :data          then rows << build_row(cells)
      end
    end
    rows.compact
  end

  def parse_row(line)
    return nil unless line.strip.start_with?("|")

    line.strip.split("|")[1..-2]&.map(&:strip)
  end

  def separator?(cells) = cells.all? { |c| c.match?(/\A:?-+:?\z/) }

  def build_row(cells)
    section    = cells[0]
    type       = cells[1]&.downcase
    slug, path = extract_link(cells[2])
    return nil unless slug

    Row.new(
      section: section,
      type:    type,
      slug:    slug,
      path:    path,
      title:   cells[3],
      stage:   cells[4]
    )
  end

  def extract_link(cell)
    m = cell&.match(/\[(?<label>[^\]]*)\]\((?<path>[^)]+)\)/)
    return [nil, nil] unless m

    [m[:label], m[:path]]
  end
end

class Meta
  attr_reader :title, :authors, :abstract

  def initialize(meta_path)
    raw = meta_path.read
    if raw.start_with?("---\n")
      _, frontmatter, body = raw.split(/^---\n/, 3)
      data      = YAML.safe_load(frontmatter)
      @title    = data["title"]
      @authors  = data["authors"] || []
      @abstract = body.strip
    else
      @title    = ""
      @authors  = []
      @abstract = raw.strip
    end
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Builder — orchestrates assembly + compilation
# ─────────────────────────────────────────────────────────────────────────────

class Builder
  # Natbib options must be \PassOptionsToPackage'd BEFORE \usepackage{neurips_2026}
  # since the sty loads natbib internally. Injected at a different splice point
  # than PREAMBLE_ADDITIONS (which lands right before \begin{document}).
  CITATION_OPTIONS = <<~TEX.freeze
    % Bracketed-superscript numeric citations per AUTHORING.md §2.3.
    \\PassOptionsToPackage{numbers,super,sort&compress}{natbib}
  TEX

  PREAMBLE_ADDITIONS = <<~TEX.freeze
    % Lualatex-native Unicode font handling. Replaces the implicit Nimbus
    % Roman setup pulled in by the NeurIPS sty's \\usepackage{times}, which
    % is missing em-dash, en-dash, Ł, Č, and other glyphs. TeX Gyre Termes
    % is the open-source Times-equivalent with full Unicode coverage —
    % keeps the NeurIPS Times look while rendering everything in our source.
    \\usepackage{fontspec}
    \\setmainfont{TeX Gyre Termes}

    \\usepackage{amsmath}
    \\usepackage{amssymb}
    \\usepackage{amsthm}
    \\usepackage{cleveref}
    % tabularx — width-distributed `X` columns for wide [!table] callouts
    % opting in via `cols="lXX..."` attribute. AUTHORING §1.4.
    \\usepackage{tabularx}

    % Hyperref boxes off — visually quieter prose; reviewers see plain text
    % rather than colored frames around every \\Cref / \\cite / footnote.
    % breaklinks=true: allow links to break across page boundaries by
    % closing-and-reopening rather than emitting a single span. Without it,
    % a hyperlink (cite, cref) that spans a page break causes pdftex's
    % pdf-backend to fatal with `'endlink' ended up in different nesting
    % level than 'startlink'` — opaque error, no PDF output. Surfaced when
    % 03-llm-hallucinate-bound's reshape spine-test build crashed at page 2.
    \\hypersetup{hidelinks,breaklinks=true,plainpages=false,pdfpagelabels=false}

    % natbib-super defaults: \\NAT@open / \\NAT@close are empty (no brackets),
    % \\NAT@super@kern adds visible kerning inside what brackets do exist.
    % Override all three so \\cite{} renders bracketed-superscript ⁽¹⁾ form
    % per REFS-AND-CITATIONS.md §3.4, and the kerning isn't visible as a
    % space between the bracket and the digit.
    \\makeatletter
    \\def\\NAT@open{[}
    \\def\\NAT@close{]}
    \\def\\NAT@super@kern{}
    \\makeatother

    % Custom \\citet so narrative cites render `Author Year⁽N⁾` instead of
    % natbib-super default `Author [N]` (which drops the year). Uses \\citep
    % directly so the bracket / kerning behavior matches the cite form.
    % Optional postnote support — `\\citet[Theorem 5]{key}` now works.
    % Default natbib `\\citet` accepts `[postnote]{key}`; our previous redef
    % took only one arg, dropping the postnote silently and breaking 9+
    % `\\citet[Theorem N]{...}` cites in 03-llm-hallucinate.
    %
    % \\mbox{} wrap: keeps author+year+superscript-bracket as a single
    % unbreakable unit. Without it, three hyperref-link calls (\\citeauthor,
    % \\citeyear, \\citep) can split across line/page breaks; if a paragraph
    % has many \\citet calls (e.g., 03-llm-hallucinate-bound's §F.2 strand-2
    % roundup with 11 narrative cites in one paragraph), the link-state
    % machinery gets confused and pdftex fatals on `'endlink' ended up in
    % different nesting level than 'startlink'`. The \\mbox keeps each cite
    % atomic for the link state.
    \\renewcommand{\\citet}[2][]{\\mbox{\\citeauthor{#2}~\\citeyear{#2}\\citep[#1]{#2}}}

    \\bibliographystyle{unsrtnat}

    % aliascnt: every theorem-like env shares the *number* of the theorem
    % counter, but each gets its own counter NAME — so cleveref reads the
    % distinct type from .aux ("lemma.2.1", "definition.3.1", ...) rather
    % than seeing everything as "theorem.N.M". Fixes flag where every
    % \\Cref{lem-...} / \\Cref{def-...} rendered as "Theorem N" because the
    % shared-counter [theorem] linkage erased the type distinction in .aux.
    % Canonical cleveref-with-shared-counters recipe (cleveref docs §10).
    \\usepackage{aliascnt}

    \\newtheorem{theorem}{Theorem}[section]

    \\newaliascnt{lemma}{theorem}
    \\newtheorem{lemma}[lemma]{Lemma}
    \\aliascntresetthe{lemma}

    \\newaliascnt{corollary}{theorem}
    \\newtheorem{corollary}[corollary]{Corollary}
    \\aliascntresetthe{corollary}

    \\newaliascnt{proposition}{theorem}
    \\newtheorem{proposition}[proposition]{Proposition}
    \\aliascntresetthe{proposition}

    \\newaliascnt{conjecture}{theorem}
    \\newtheorem{conjecture}[conjecture]{Conjecture}
    \\aliascntresetthe{conjecture}

    \\newaliascnt{claim}{theorem}
    \\newtheorem{claim}[claim]{Claim}
    \\aliascntresetthe{claim}

    \\newaliascnt{hypothesis}{theorem}
    \\newtheorem{hypothesis}[hypothesis]{Hypothesis}
    \\aliascntresetthe{hypothesis}

    \\theoremstyle{definition}
    \\newaliascnt{definition}{theorem}
    \\newtheorem{definition}[definition]{Definition}
    \\aliascntresetthe{definition}

    \\theoremstyle{remark}
    \\newaliascnt{remark}{theorem}
    \\newtheorem{remark}[remark]{Remark}
    \\aliascntresetthe{remark}

    \\crefname{theorem}{Theorem}{Theorems}
    \\crefname{lemma}{Lemma}{Lemmas}
    \\crefname{corollary}{Corollary}{Corollaries}
    \\crefname{proposition}{Proposition}{Propositions}
    \\crefname{conjecture}{Conjecture}{Conjectures}
    \\crefname{claim}{Claim}{Claims}
    \\crefname{hypothesis}{Hypothesis}{Hypotheses}
    \\crefname{definition}{Definition}{Definitions}
    \\crefname{remark}{Remark}{Remarks}
    \\crefname{table}{Table}{Tables}
    \\crefname{figure}{Figure}{Figures}
    \\crefname{equation}{Equation}{Equations}
    \\crefname{section}{Section}{Sections}
    \\crefname{appendix}{Appendix}{Appendices}
  TEX

  def initialize(paper_dir, manifest_stem)
    @paper_dir          = (ROOT / paper_dir).expand_path
    @manifest_stem      = manifest_stem
    @out_dir            = @paper_dir / "out"
    @lint_findings      = []
    @has_unresolved_refs = false
  end

  def call
    raise "paper dir not found: #{@paper_dir}" unless @paper_dir.directory?

    meta     = Meta.new(@paper_dir / "meta.md")
    manifest = Manifest.new(@paper_dir / "OUT.#{@manifest_stem}.md")

    body_tex = assemble_body(manifest)
    body_tex = resolve_unresolved_refs(body_tex)
    full_tex = render_template(meta, body_tex)

    FileUtils.mkdir_p(@out_dir)
    tex_path = @out_dir / "#{@manifest_stem}.tex"
    tex_path.write(full_tex)

    compile_pdf(tex_path)
    report_lint
    pdf_path = @out_dir / "#{@manifest_stem}.pdf"
    puts "✓ #{pdf_path.relative_path_from(ROOT)}"
  end

  private

  # Replace `\Cref{X}` / `\eqref{X}` / `\cite[opt]{X}` (and natbib variants)
  # that point to undefined labels or bib-keys with a visible placeholder
  # rather than letting LaTeX/hyperref crash. Without this guard, an
  # unresolved `\Cref{anchor}` or `\cite{missing-key}` under super-style
  # natbib + hyperref produces the opaque pdf-backend fatal
  # `'endlink' ended up in different nesting level than 'startlink'` and
  # emits NO PDF — hard-blocking the incremental-authoring workflow that
  # makes segmented papers worthwhile. (Plain LaTeX would have warned and
  # rendered `??` / `[?]`; hyperref escalates to fatal because the link
  # state is malformed.)
  #
  # The fix walks the assembled body and:
  #  - Collects every `\label{X}` definition into a set; rewrites unresolved
  #    `\Cref{X}` / `\eqref{X}` to `[?~label]` (visible in PDF, lint warning).
  #  - Loads valid bib-keys from `refs/entries/*.yml`; rewrites every
  #    `\cite[opt]{a,b,c}` to drop unknown keys and append `[?~unknown-key]`
  #    placeholders. Resolved keys pass through unchanged; partial-resolution
  #    keeps the known cites working.
  #
  # Resolves PIPELINE-TODO inbox flag `[03-llm-hallucinate-bound + general]
  # [[#^anchor]] to a not-yet-defined label crashes the build` (2026-05-06).
  # The flag was titled around `[[#^anchor]]` but the same hyperref nesting
  # crash is triggered by undefined `\cite{}` keys; both are handled here.
  # Placeholder for unresolved cross-refs / cite-keys. Visible in the rendered
  # PDF (so the author sees that the reference is unresolved) without
  # triggering hyperref's link-state machinery — that's why the placeholder
  # is plain text rather than `\textbf{...}` or `\textit{...}`. Empirically
  # `\textbf{[?~label]}` re-triggers the same hyperref endlink/startlink
  # nesting fatal that the placeholder is supposed to avoid (likely because
  # `\textbf` interacts with hyperref's link-state tracking around the
  # surrounding cite/cref calls). Plain bracketed text with `\,` thin space
  # has no such interaction.
  UNRESOLVED_PLACEHOLDER = ->(label) { "[?\\,#{label}]" }
  CITE_CMD_RE            = /\\(cite|citet|citep|citealt|citealp|citeauthor|citeyear)\*?(\[[^\]]*\])?\{([^}]+)\}/.freeze

  # Set of bib-keys bibtex will resolve at compile time. Prefer parsing the
  # paper's local `refs.bib` (the authoritative artifact bibtex actually reads
  # via BIBINPUTS) when present; fall back to the umbrella's `refs/entries/`
  # for fresh papers that haven't run `bin/refs emit` yet. The local-refs.bib
  # path matters for `00-test-paper` which has a hand-curated refs.bib whose
  # keys diverge from the umbrella canonical form (e.g., `boyd-1994-lmi` vs
  # `boyd-ghaoui-feron-balakrishnan-1994-lmi`).
  def valid_bib_keys
    @valid_bib_keys ||= begin
      local_bib = @paper_dir / "refs.bib"
      if local_bib.exist?
        local_bib.read.scan(/^@\w+\{([^,\s]+)\s*,/).flatten.to_set
      else
        (ROOT / "refs" / "entries").glob("*.yml").map { |p| p.basename(".yml").to_s }.to_set
      end
    end
  end

  def resolve_unresolved_refs(body_tex)
    defined    = body_tex.scan(/\\label\{([^}]+)\}/).flatten.to_set
    unresolved_refs = []

    rewritten = body_tex.gsub(/\\(?:Cref|eqref)\{([^}]+)\}/) do
      label = Regexp.last_match(1)
      if defined.include?(label)
        Regexp.last_match(0)
      else
        unresolved_refs << label
        UNRESOLVED_PLACEHOLDER.call(label)
      end
    end

    unresolved_cites = []
    valid = valid_bib_keys
    rewritten = rewritten.gsub(CITE_CMD_RE) do
      cmd, opt, keys = Regexp.last_match(1), Regexp.last_match(2), Regexp.last_match(3)
      key_list      = keys.split(",").map(&:strip)
      known         = key_list.select { |k| valid.include?(k) }
      unknown       = key_list - known
      unresolved_cites.concat(unknown)

      if unknown.empty?
        Regexp.last_match(0)
      elsif known.empty?
        unknown.map { |k| UNRESOLVED_PLACEHOLDER.call(k) }.join(", ")
      else
        # Partial resolution: keep the known cite call, append unknown placeholders.
        "\\#{cmd}#{opt}{#{known.join(',')}} " + unknown.map { |k| UNRESOLVED_PLACEHOLDER.call(k) }.join(", ")
      end
    end

    unresolved_refs.uniq.each  { |l| @lint_findings << "unresolved cross-ref: #{l}" }
    unresolved_cites.uniq.each { |k| @lint_findings << "unresolved cite-key: #{k} (run `bin/refs add` to land the entry)" }
    @has_unresolved_refs = !unresolved_refs.empty? || !unresolved_cites.empty?
    rewritten
  end

  def assemble_body(manifest)
    body         = +""
    appendix_set = false

    manifest.rows.each do |row|
      if row.type == "appendix" && !appendix_set
        body << "\n\\appendix\n\n"
        appendix_set = true
      end
      body << "\n\\newpage\n" if row.type == "checklist"
      body << if row.type == "bibliography"
                "\n\\bibliography{refs}\n\n"
              else
                render_segment(row)
              end
    end
    body
  end

  # Sentinel character used to mask `|` inside math spans before kramdown
  # parses, so kramdown's table parser doesn't see them as cell separators.
  # Restored after rendering. \x01 (start-of-heading) is a control character
  # never present in normal user content.
  # rubocop:disable Lint/UselessConstantScoping -- constants don't actually
  # become private without `private_constant`; this constant is mid-class for
  # locality with the methods that use it, not a privacy declaration.
  MATH_PIPE_SENTINEL = "\x01".freeze
  CITE_ARG_OPEN      = "\x02".freeze
  CITE_ARG_CLOSE     = "\x03".freeze
  # rubocop:enable Lint/UselessConstantScoping

  def render_segment(row)
    src_path = @paper_dir / row.path
    raise "segment not found: #{src_path}" unless src_path.exist?

    content = src_path.read
    lint_anonymization(content, row.path)
    if src_path.extname == ".tex"
      "#{content}\n"
    else
      content = mask_math_pipes(content)
      content = mask_cite_postnotes(content)
      doc     = Kramdown::Document.new(content, input: "NeurIPS")
      attach_equation_anchors!(doc.root)
      out, warnings = doc.to_neurips
      warnings.each { |w| @lint_findings << "#{row.path}: #{w}" }
      out = out.tr(MATH_PIPE_SENTINEL, "|")
      unmask_cite_postnotes(out)
    end
  end

  # Mask `|` inside inline `$...$` and block `$$...$$` math spans so kramdown's
  # table parser (which is line-based and triggers on enough pipe characters
  # in a paragraph) doesn't see them. Otherwise prose like `$|x|/|y|$` gets
  # carved into a `\begin{tabular}` block, escaping `_` / `^` as text.
  # Resolves the pipe-in-math flags from 01-tragedy and paper-#2 migration.
  def mask_math_pipes(text)
    # Block math first ($$...$$) so the inline pass doesn't mis-eat them.
    text = text.gsub(/\$\$(.*?)\$\$/m) do
      "$$#{Regexp.last_match(1).tr('|', MATH_PIPE_SENTINEL)}$$"
    end
    # Inline math ($...$, single-dollar, lookarounds skip $$ pairs).
    text.gsub(/(?<!\$)\$(?!\$)([^$\n]+?)\$(?!\$)/) do
      "$#{Regexp.last_match(1).tr('|', MATH_PIPE_SENTINEL)}$"
    end
  end

  # Mask the bracketed postnote of `\cite[postnote]{key}` (and the citet /
  # citep / citealt / citealp / citeauthor / citeyear variants) so kramdown's
  # text-handling and our ESCAPE_MAP don't mangle LaTeX-meaningful characters
  # inside it. Authors write `\cite[ch.~4 \& 9]{key}` with `~` (non-breaking
  # space) and `\&` (escaped ampersand) per natbib convention; without
  # masking, ESCAPE_MAP turns `~` into `\textasciitilde{}` and `&` into `\&`
  # (yielding `\\&` for the already-escaped author form), which breaks
  # lualatex with "Misplaced alignment tab character &". Replace each
  # bracketed postnote with `\<S>N<S>` where N indexes into @cite_postnote_stash;
  # restore in unmask_cite_postnotes after kramdown + the LaTeX converter
  # finish. The whole `\cite{key}` form is already raw-TeX passthrough policy
  # (AUTHORING §4); the postnote bracket is a natural extension of that
  # passthrough scope.
  CITE_PREFIX_RE = /\\cite(?:t|p|alt|alp|author|year)?[*]?/.freeze
  CITE_ARG_RE    = /(#{CITE_PREFIX_RE})\[([^\]\n]*)\]/.freeze

  def mask_cite_postnotes(text)
    @cite_postnote_stash ||= []
    text.gsub(CITE_ARG_RE) do
      cmd  = Regexp.last_match(1)
      note = Regexp.last_match(2)
      idx  = @cite_postnote_stash.length
      @cite_postnote_stash << note
      "#{cmd}[#{CITE_ARG_OPEN}#{idx}#{CITE_ARG_CLOSE}]"
    end
  end

  def unmask_cite_postnotes(tex)
    return tex unless @cite_postnote_stash

    tex.gsub(/#{Regexp.escape(CITE_ARG_OPEN)}(\d+)#{Regexp.escape(CITE_ARG_CLOSE)}/) do
      @cite_postnote_stash[Regexp.last_match(1).to_i] || ""
    end
  end

  # AUTHORING §1.7 — anchored equations are the convention (replacing manual
  # \tag{N}). Source `$$ ... $$ ^eq-name` parses as `:p > :math + :text " ^eq-
  # name"` (kramdown demotes block-math to span when content trails on the
  # same line). Walk the tree post-parse; pair each :math with its trailing
  # ^anchor text node, attach as data-eq-anchor on the math element. The
  # convert_math override then emits \begin{equation}\label{}...\end{equation}
  # (or \begin{align} for \begin{aligned} content).
  #
  # Architecture note: previously this was a segment-prep-level regex rewrite
  # that pre-processed the source string before kramdown saw it. That broke
  # in two real ways flagged by the 01-tragedy migration agent (PIPELINE-TODO
  # ## Inbox 2026-05-05): (1) display math inside callout blockquotes — the
  # rewrite emitted equation envs at top level, dropping the `> ` prefixes
  # and breaking the blockquote; (2) `$$...$$` inside backtick codespans
  # got eaten as math openers, corrupting the next real equation. Doing the
  # work at the AST level instead — kramdown already respects blockquote and
  # codespan boundaries — fixes both at once.
  def attach_equation_anchors!(el)
    el.children.each { |c| attach_equation_anchors!(c) }

    i = 0
    while i < el.children.length - 1
      cur                                                      = el.children[i]
      nxt                                                      = el.children[i + 1]
      i                                                        += 1
      next unless cur.type == :math && nxt.type == :text && (m = nxt.value.match(/\A(\s*)\^([\w-]+)\s*(.*)\z/m))

      cur.attr["data-eq-anchor"] = m[2]
      remainder = (m[1] || "") + (m[3] || "")
      if remainder.strip.empty?
        el.children.delete_at(i)
        i -= 1
      else
        nxt.value = remainder
      end
    end
  end

  # PIPELINE-TODO §B4 / §B5 — scan segment source against refs/deny-list.yml
  # for anonymization vocabulary (Personal / Framework proper-nouns / ELI
  # names) plus self-cite DOIs (ASF Zenodo). Surfaces as build-time warnings;
  # `bin/refs lint` covers the bib-side independently. Per AUTHORING §3.5
  # critical exception, working notes inside spikes/ and _archive/ can use
  # internal terminology — the lint runs on segment source consumed by the
  # build, which only includes what the manifest actually assembles.
  def lint_anonymization(text, source_path)
    @deny_list ||= load_deny_list
    return unless @deny_list

    @deny_list["dois"]&.each do |doi|
      next unless text.include?(doi)

      @lint_findings << "#{source_path}: deny-listed DOI present: #{doi} (AUTHORING §3.5 — ASF self-cite is double-blind violation)"
    end

    @deny_list["authors"]&.each do |surname|
      next unless text.match?(/\b#{Regexp.escape(surname)}\b/)

      @lint_findings << "#{source_path}: self-cite-flag surname '#{surname}' present (verify third-person framing)"
    end

    @deny_list["proper_nouns"]&.each do |name|
      next unless text.match?(/\b#{Regexp.escape(name)}\b/)

      @lint_findings << "#{source_path}: anonymization vocab '#{name}' present (AUTHORING §3.5 — must not appear in submitted PDF)"
    end
  end

  def load_deny_list
    path = ROOT / "refs" / "deny-list.yml"
    return nil unless path.exist?

    YAML.safe_load_file(path)
  end

  def render_template(meta, body_tex)
    template = TEMPLATE.read

    # Replace title — anchored to line-start so we skip `\title{}` occurrences
    # inside comment lines (the template has `% Note. ... both \title{} and
    # \workshoptitle{} are required...` which otherwise eats the substitution
    # and leaves the actual title-line at the template default).
    template = template.sub(/^\\title\{[^}]*\}/) { "\\title{#{meta.title}}" }

    # Replace author block (multi-line; from `\author{` at line start to its
    # closing `}\n`). Same line-anchoring as title to avoid commented-out
    # `\author{}` examples.
    template = template.sub(/^\\author\{.*?\n\}\n/m) { "#{render_author_block(meta)}\n" }

    # Replace abstract — run through the same kramdown→LaTeX pipeline as
    # segment bodies so authoring conventions ($..$ inline math, *emph*,
    # **strong**, smart quotes, em-dashes) all render correctly. Without
    # this, *emph* lands in the PDF as literal asterisks (caught by the
    # 03-llm-hallucinate migration agent on first build, 2026-05-05).
    abstract_tex = render_inline_markdown(meta.abstract)
    template = template.sub(/\\begin\{abstract\}.*?\\end\{abstract\}/m) do
      "\\begin{abstract}\n#{abstract_tex}\n\\end{abstract}"
    end

    # Citation options BEFORE \usepackage{neurips_2026} (sty loads natbib + hyperref
    # internally, so options must be passed before the sty is loaded). Same
    # splice point handles the conditional hyperref `draft` option-pass when
    # the build has unresolved cross-refs / cite-keys (see resolve_unresolved_refs).
    # Without `draft=true`, lualatex's pdf-backend can fatal on
    # `'endlink' ended up in different nesting level than 'startlink'` during
    # pass 3 — an opaque error that emits NO PDF and hard-blocks incremental
    # builds of multi-segment papers. Hyperref reads `draft` only at
    # \usepackage time; `\hypersetup{draft=true}` later is silently ignored
    # ("Option `draft' has already been used, setting the option has no
    # effect"), so the option must come BEFORE the sty loads. The
    # `[?\,label]` placeholder text from resolve_unresolved_refs already
    # conveys unresolved state visibly; sacrificing clickable hyperlinks in
    # this transitional state is a fair trade. Resolved-ref builds (full-
    # paper, neurips-2026-paper after content migration completes) keep
    # normal hyperref behavior.
    pre_sty_options = String.new(CITATION_OPTIONS)
    pre_sty_options << "\\PassOptionsToPackage{draft}{hyperref}\n" if @has_unresolved_refs
    template = template.sub("\\usepackage{neurips_2026}") do
      "#{pre_sty_options}\\usepackage{neurips_2026}"
    end

    # Other preamble additions (theorem envs + cleveref + hidelinks + \citet redef)
    # right before \begin{document}.
    template = template.sub("\\begin{document}") { "#{PREAMBLE_ADDITIONS}\n\\begin{document}" }

    # Replace body: from after \begin{abstract}...\end{abstract} to \end{document}.
    # Block form is mandatory — body_tex contains literal backslashes (\\, \&,
    # \emph{...}) that String#sub's replacement-string interpretation would
    # otherwise consume as backreferences/escapes.
    template.sub(/(\\end\{abstract\}\n).*?(\\end\{document\})/m) do
      "#{Regexp.last_match(1)}\n#{body_tex}\n#{Regexp.last_match(2)}"
    end
  end

  # Same kramdown→LaTeX pipeline used for segment bodies, exposed for the
  # abstract (and any other inline-markdown metadata that needs rendering).
  def render_inline_markdown(text)
    doc = Kramdown::Document.new(text, input: "NeurIPS")
    out, _warnings = doc.to_neurips
    out.strip
  end

  def render_author_block(meta)
    lines = ["\\author{%"]
    meta.authors.each_with_index do |a, i|
      lines << "  \\And" if i.positive?
      lines << "  #{a['name']} \\\\"
      lines << "  #{a['affiliation']} \\\\" if a["affiliation"]
      lines << "  \\texttt{#{a['email']}} \\\\" if a["email"]
    end
    lines << "}"
    lines.join("\n")
  end

  def compile_pdf(tex_path)
    env = {
      "TEXINPUTS" => "#{COMMON_DIR}:#{@paper_dir}:",
      "BIBINPUTS" => "#{@paper_dir}:"
    }
    lualatex_cmd = [
      "lualatex",
      "-interaction=nonstopmode",
      "-halt-on-error",
      "-output-directory=#{@out_dir}",
      tex_path.to_s
    ]
    bibtex_cmd = ["bibtex", tex_path.basename(".tex").to_s]

    # lualatex → bibtex → lualatex → lualatex resolves \cite{} + \Cref{}
    # cross-references on the third pass; standard latex bibliography dance.
    run_compile_step(env, lualatex_cmd, "lualatex (pass 1)")
    run_compile_step(env, bibtex_cmd,   "bibtex", allow_fail: true)
    run_compile_step(env, lualatex_cmd, "lualatex (pass 2)")
    run_compile_step(env, lualatex_cmd, "lualatex (pass 3)")
  end

  def run_compile_step(env, cmd, label, allow_fail: false)
    out, status = Open3.capture2e(env, *cmd, chdir: @out_dir.to_s)
    return if status.success? || allow_fail

    tail = out.lines.last(40).join
    raise "#{label} failed:\n#{tail}"
  end

  def report_lint
    return if @lint_findings.empty?

    warn "── Lint findings (#{@lint_findings.size}) ──"
    @lint_findings.each { |f| warn "  #{f.inspect}" }
  end
end

# Wire up the converter so `doc.to_neurips` works (kramdown's auto-method
# generation expects the converter to be registered via `convert(method_name)`).
class Kramdown::Document
  def to_neurips
    output = Kramdown::Converter::NeurIPS.convert(@root, @options)
    output.is_a?(Array) ? output : [output, []]
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# CLI entry
# ─────────────────────────────────────────────────────────────────────────────

if $PROGRAM_NAME == __FILE__
  if ARGV.empty?
    warn "usage: bin/build <paper-dir> [manifest-stem]"
    exit 1
  end
  paper_dir     = ARGV[0]
  manifest_stem = ARGV[1] || "test"
  Builder.new(paper_dir, manifest_stem).call
end
