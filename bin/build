#!/usr/bin/env ruby
#
# bin/build — assemble a paper from an OUT.*.md manifest into a NeurIPS-formatted PDF.
#
# Usage:
#   bin/build <paper-dir> [manifest-stem]
#
#   <paper-dir>      e.g., 00-test-paper, 01-tragedy-confident-agent
#   [manifest-stem]  defaults to "test" (reads OUT.test.md). Reads OUT.<stem>.md.
#
# Phase A scope: read meta.md (YAML frontmatter + abstract), parse the OUT.*.md
# assembly manifest, render each segment via a kramdown→LaTeX pipeline that
# routes Obsidian callouts (> [!theorem] / [!lemma] / etc.) to amsthm
# environments, [[#^anchor]] cross-refs to \Cref{anchor}, [!table] callouts to
# \begin{table}+caption+label+tabular, [!note]/[!todo]/[!info]/[!warning]/[!tip]
# to nothing (stripped). Splice into common/neurips_2026.tex template, run
# lualatex twice, output to <paper-dir>/out/<stem>.pdf.
#
# Architecture:
#   * Kramdown::Parser::NeurIPS — parser-level extension. Recognizes the
#     Obsidian callout pattern (`> [!type] title ^anchor`) at tokenize time
#     and stores type / title / anchor as attributes on the resulting
#     blockquote element. Same trick for header-trailing `^anchor`. Adds a
#     single-dollar inline-math span parser ($x$) since upstream kramdown
#     only recognizes $$...$$. Marker extraction runs as a *block* parser
#     (before any span parsing), so titles can contain $math$ without
#     fragmenting the marker into text-node soup.
#   * Kramdown::Converter::NeurIPS — converter consumes the pre-extracted
#     attributes (no regex digging through text nodes) and emits LaTeX.
#
# Raw TeX passes through unmodified — backslash sequences, environments, and
# braces are author-intentional LaTeX. Only %, &, _, #, ~, ^ are escaped (these
# are LaTeX-special but commonly used in prose with non-LaTeX meaning).
#
# Lint findings are collected as a side effect of AST traversal and printed
# at the end. Build does not auto-fix; --strict will fail on lint findings
# (deferred until Phase B).

require "kramdown"
require "kramdown/parser/kramdown"
require "yaml"
require "fileutils"
require "open3"

ROOT       = Pathname.new(__dir__).parent.expand_path
COMMON_DIR = ROOT / "common"
TEMPLATE   = COMMON_DIR / "neurips_2026.tex"

# ─────────────────────────────────────────────────────────────────────────────
# Custom kramdown parser — extracts callout markers and header anchors at
# parse time so they reach the converter as element attributes (rather than
# fragments of text-node soup that span parsing could shred).
# ─────────────────────────────────────────────────────────────────────────────

class Kramdown::Parser::NeurIPS < Kramdown::Parser::Kramdown
  # An Obsidian-style callout is a blockquote whose first non-whitespace
  # content is `[!type]` (optionally followed by `+` or `-` for fold state).
  # We claim those before the standard :blockquote parser sees them.
  CALLOUT_START   = /^#{OPT_SPACE}>[ \t]*\[!(?<type>\w+)\][+-]?/
  MARKER_LINE     = /\A\[!(?<type>\w+)\][+-]?[ \t]*(?<rest>.*?)\s*(?:\n|\z)/m
  MARKER_REST     = /\A(?<title>.*?)(?:\s+\^(?<anchor>[\w-]+))?\s*\z/
  HEADER_ANCHOR   = /\A(?<text>.*?)\s+\^(?<anchor>[\w-]+)\s*\z/

  # Single-dollar inline math. Upstream kramdown only recognizes $$...$$, so
  # plain `$x$` would otherwise leak through unparsed. The lookarounds keep
  # us out of $$...$$'s lane (handled by upstream :inline_math).
  SINGLE_DOLLAR_MATH = /(?<!\$)\$(?!\$)([^$\n]+?)\$(?!\$)/

  def initialize(source, options)
    super
    unless @block_parsers.include?(:callout)
      bq_idx = @block_parsers.index(:blockquote) || 0
      @block_parsers.insert(bq_idx, :callout)
    end
    @span_parsers.unshift(:single_dollar_math) unless @span_parsers.include?(:single_dollar_math)
  end

  def parse_single_dollar_math
    line     = @src.current_line_number
    @src.pos += @src.matched_size
    @tree.children << Element.new(:math, @src[1].strip, nil, category: :span, location: line)
  end
  define_parser(:single_dollar_math, SINGLE_DOLLAR_MATH, "\\$")

  # Slurp the contiguous `> ...` lines (same algorithm as parse_blockquote),
  # then peel off the marker line, attach (type / title / anchor) to the
  # blockquote element as attributes, and recurse on the remainder.
  #
  # rubocop:disable Naming/PredicateMethod -- kramdown's parse_* protocol
  # returns true/false to signal "claimed the input" vs "passed"; matching
  # that contract is more important than the boolean-method naming convention.
  def parse_callout
    start_line = @src.current_line_number
    raw        = @src.scan(self.class::PARAGRAPH_MATCH)
    raw << @src.scan(self.class::PARAGRAPH_MATCH) until @src.match?(self.class::LAZY_END)
    raw.gsub!(self.class::BLOCKQUOTE_START, "")

    marker = raw.match(MARKER_LINE)
    return false unless marker

    type     = marker[:type].downcase
    title    = nil
    anchor   = nil
    if (rest = marker[:rest]) && !rest.empty? && (rm = rest.match(MARKER_REST))
      title  = rm[:title].to_s.strip
      title  = nil if title.empty?
      anchor = rm[:anchor]
    end
    body = raw[marker[0].length..]

    el = new_block_el(:blockquote, nil, nil, location: start_line)
    el.attr["data-callout-type"]   = type
    el.attr["data-callout-title"]  = title  if title
    el.attr["data-callout-anchor"] = anchor if anchor
    @tree.children << el
    parse_blocks(el, body)
    true
  end
  # rubocop:enable Naming/PredicateMethod
  define_parser(:callout, CALLOUT_START)

  # Headers may carry a trailing `^anchor` (Obsidian block-reference syntax).
  # Override add_header to peel that off before the text becomes a child node;
  # we expose it as the data-header-anchor attribute for the converter.
  def add_header(level, text, id)
    anchor = nil
    if (m  = text.match(HEADER_ANCHOR))
      text   = m[:text]
      anchor = m[:anchor]
    end
    super
    return unless anchor

    @tree.children.last.attr["data-header-anchor"] = anchor
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Custom kramdown→LaTeX converter
# ─────────────────────────────────────────────────────────────────────────────

class Kramdown::Converter::NeurIPS < Kramdown::Converter::Latex
  # Characters we still escape in body text. We deliberately exclude
  # backslash, braces, and dollar — those are author-intentional LaTeX
  # (raw-TeX passthrough policy). The included characters are LaTeX-special
  # but commonly meant literally in prose.
  ESCAPE_MAP = {
    "%" => "\\%",
    "&" => "\\&",
    "_" => "\\_",
    "#" => "\\#",
    "~" => "\\textasciitilde{}",
    "^" => "\\textasciicircum{}"
  }.freeze
  ESCAPE_RE = /[%&_#~^]/

  # Codespans (backtick-wrapped inline content) are the escape hatch for
  # literal LaTeX characters — raw-TeX passthrough doesn't apply here. Author
  # writing `\Cref{thm-main}` inside backticks means "render the literal
  # string `\Cref{thm-main}`", not "execute the cleveref command." So we
  # apply the FULL escape inside codespans (backslash, braces, dollar, plus
  # everything in ESCAPE_MAP).
  CODESPAN_ESCAPE_MAP = ESCAPE_MAP.merge(
    "\\" => "\\textbackslash{}",
    "{"  => "\\{",
    "}"  => "\\}",
    "$"  => "\\$"
  ).freeze
  CODESPAN_ESCAPE_RE = /[\\{}$%&_#~^]/

  # Obsidian-callout types that map to amsthm-style numbered environments.
  # All share a single counter via amsthm's optional-counter mechanism.
  THEOREM_LIKE = %w[
    theorem lemma corollary proposition conjecture claim hypothesis
    definition remark
  ].freeze

  # Callout types that consume the body but emit no LaTeX — authoring
  # sidebars, working notes, drafting reminders.
  STRIP_LIKE = %w[note todo info warning tip].freeze

  # Cross-reference pattern (Obsidian wikilink for block references).
  CREF_PATTERN = /\[\[#\^([\w-]+)\]\]/

  # Trailing ` {-}` after a heading marks it unnumbered (Pandoc-style).
  HEADER_UNNUMBERED = /\s*\{-\}\s*\z/

  # ── Escape policy ────────────────────────────────────────────────────────

  # Override the inherited escape — passthrough \, {, }, $; resolve cross-refs
  # at the text level before the special-character escape pass.
  # Cross-ref router: anchors prefixed `eq-` render as \eqref{} (parenthesized
  # number, AUTHORING §1.7 convention); all other anchors use \Cref{} which
  # cleveref types automatically (Theorem N / Lemma N / Section N / etc.).
  def escape(str)
    str
      .gsub(CREF_PATTERN) do
        anchor = Regexp.last_match(1)
        anchor.start_with?("eq-") ? "\\eqref{#{anchor}}" : "\\Cref{#{anchor}}"
      end
      .gsub(ESCAPE_RE, ESCAPE_MAP)
  end

  # Full-escape variant for codespan content. See CODESPAN_ESCAPE_MAP comment.
  def codespan_escape(str) = str.gsub(CODESPAN_ESCAPE_RE, CODESPAN_ESCAPE_MAP)

  # ── Element converters ───────────────────────────────────────────────────

  def convert_codespan(el, _opts) = "\\texttt{#{codespan_escape(el.value)}}"

  # Kramdown auto-wraps standalone-image paragraphs in `\begin{figure}\begin
  # {center}...\caption{alt}\end{center}\end{figure}`. Our `[!figure]` callout
  # is the canonical figure wrapper (carries the caption / label / centering),
  # so we suppress the auto-wrap and just emit the \includegraphics — let the
  # callout do the figure shaping. Bare `![alt](path)` outside a `[!figure]`
  # callout therefore renders as a plain inclusion; authors wanting a numbered
  # figure use the callout form per AUTHORING §1.5.
  def convert_standalone_image(_el, _opts, img) = img

  # Paragraph-leading bold-then-period — the academic-prose `**Two regimes.**
  # body...` shape — auto-converts to `\paragraph{Two regimes} body...` per
  # AUTHORING.md §1.9. Detection: rendered paragraph that starts with
  # \textbf{...}. with period inside the brace, followed by whitespace.
  #
  # Limited to top-level paragraphs (parent is :root). Paragraphs inside list
  # items, blockquotes, table cells, callouts, etc. would break LaTeX's
  # structural hierarchy if rewritten as \paragraph{}.
  PARAGRAPH_HEADING_RE = /\A\\textbf\{([^}]+?)\.\}\s*/

  def convert_p(el, opts)
    rendered = super
    return rendered unless opts[:parent]&.type == :root

    rendered.sub(PARAGRAPH_HEADING_RE) { "\\paragraph{#{Regexp.last_match(1)}} " }
  end

  # Lint rule §B1: manual heading numbering ("## 3. Title", "### 3.1 Subtitle")
  # violates AUTHORING §1.8 — LaTeX numbers automatically. Warn so migration
  # agents see these and strip during their pass.
  MANUAL_HEADING_NUMBER_RE = /\A(?:\d+\.)+\d*\s+/

  def convert_header(el, opts)
    raw_title = inner(el, opts)
    starred   = false
    if raw_title.match?(HEADER_UNNUMBERED)
      raw_title = raw_title.sub(HEADER_UNNUMBERED, "")
      starred   = true
    end
    warning("manual heading numbering — strip per AUTHORING §1.8: #{raw_title.inspect}") if raw_title.match?(MANUAL_HEADING_NUMBER_RE)
    cmd     = header_command(el.options[:level])
    anchor  = el.attr["data-header-anchor"]
    result  = "\\#{cmd}#{'*' if starred}{#{raw_title.strip}}\n"
    result << "\\label{#{anchor}}\n" if anchor && !starred
    result << "\n"
    result
  end

  # Lint rule §B3: manual \tag{N} in display math violates AUTHORING §1.7
  # (anchored equations + [[#^eq-name]] cross-refs are the convention).
  # Warn at conversion time so migration agents see them.
  MANUAL_TAG_RE = /\\tag\*?\{[^}]+\}/

  def convert_math(el, opts)
    if el.value.match?(MANUAL_TAG_RE)
      warning("manual \\tag{} in math — use ^eq-anchor + [[#^eq-anchor]] per AUTHORING §1.7: #{el.value.lines.first.strip.inspect}")
    end
    super
  end

  def convert_blockquote(el, opts)
    type = el.attr["data-callout-type"]
    return super unless type
    return "" if STRIP_LIKE.include?(type)

    marker = {
      title:  escape_title(el.attr["data-callout-title"]),
      anchor: el.attr["data-callout-anchor"]
    }
    body = inner(el, opts).strip

    case type
    when *THEOREM_LIKE then render_theorem_like(type, marker, body)
    when "proof"       then render_proof(marker, body)
    when "table"       then render_table_callout(marker, body)
    when "figure"      then render_figure_callout(marker, body)
    when "quote"       then "\\begin{quote}\n#{body}\n\\end{quote}\n\n"
    else
      warning("unknown callout type: [!#{type}] — passing through as plain blockquote")
      super
    end
  end

  # convert_table is invoked both at top level and inside [!table] callouts.
  # We always emit just the tabular; the [!table] callout supplies the
  # \begin{table}\caption\label{}\centering wrapper.
  def convert_table(el, opts)
    alignments = el.options[:alignment].map { |a| ALIGN_MAP[a] || "l" }
    out        = "\\begin{tabular}{#{alignments.join}}\n"
    out << "\\toprule\n"
    out << inner(el, opts)
    out << "\\bottomrule\n"
    out << "\\end{tabular}\n"
    out
  end

  ALIGN_MAP = { left: "l", right: "r", center: "c", default: "l" }.freeze

  def convert_thead(el, opts) = "#{inner(el, opts)}\\midrule\n"
  def convert_tbody(el, opts) = inner(el, opts)
  def convert_tfoot(el, opts) = inner(el, opts)

  def convert_tr(el, opts)
    cells = el.children.map { |c| inner(c, opts).strip }
    "#{cells.join(' & ')} \\\\\n"
  end

  def convert_td(el, opts) = inner(el, opts)

  # ── Helpers ──────────────────────────────────────────────────────────────

  private

  # Title strings (callout titles, header text) live outside the kramdown
  # span-parsed AST, so Cref substitution and special-character escaping
  # need explicit application here. Math regions ($...$ and $$...$$) are
  # passed through verbatim — `^` and `_` are operators there, not text.
  def escape_title(str)
    return nil if str.nil?

    out   = +""
    parts = str.split(/(\$\$[^$]*\$\$|\$[^$\n]+?\$)/)
    parts.each do |part|
      out << if part.start_with?("$")
               part
             else
               part.gsub(CREF_PATTERN) { "\\Cref{#{Regexp.last_match(1)}}" }.gsub(ESCAPE_RE, ESCAPE_MAP)
             end
    end
    out
  end

  def header_command(level)
    case level
    when 1, 2 then "section"
    when 3    then "subsection"
    when 4    then "subsubsection"
    else           "paragraph"
    end
  end

  def render_theorem_like(env, marker, body)
    out  = "\\begin{#{env}}"
    out << "[#{marker[:title]}]" if marker[:title]
    out << "\n"
    out << "\\label{#{marker[:anchor]}}\n" if marker[:anchor]
    out << body
    out << "\n\\end{#{env}}\n\n"
    out
  end

  def render_proof(marker, body)
    out  = +"\\begin{proof}"
    out << "[#{marker[:title]}]" if marker[:title]
    out << "\n"
    out << body
    out << "\n\\end{proof}\n\n"
    out
  end

  def render_table_callout(marker, body)
    out  = +"\\begin{table}[h]\n"
    out << "  \\centering\n"
    out << "  \\caption{#{marker[:title]}}\n" if marker[:title]
    out << "  \\label{#{marker[:anchor]}}\n"  if marker[:anchor]
    out << body
    out << "\n\\end{table}\n\n"
    out
  end

  def render_figure_callout(marker, body)
    out  = +"\\begin{figure}[h]\n"
    out << "  \\centering\n"
    out << body
    out << "\n  \\caption{#{marker[:title]}}\n" if marker[:title]
    out << "  \\label{#{marker[:anchor]}}\n"    if marker[:anchor]
    out << "\\end{figure}\n\n"
    out
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Manifest & meta parsing
# ─────────────────────────────────────────────────────────────────────────────

class Manifest
  Row = Struct.new(:section, :type, :slug, :path, :title, :stage, keyword_init: true)

  attr_reader :rows

  def initialize(manifest_path)
    @path = manifest_path
    @rows = parse
  end

  private

  def parse
    rows  = []
    state = :outside
    @path.each_line do |line|
      next unless line.start_with?("|")

      cells = parse_row(line)
      next unless cells

      case state
      when :outside       then state = :header
      when :header        then state = (separator?(cells) ? :data : :outside)
      when :data          then rows << build_row(cells)
      end
    end
    rows.compact
  end

  def parse_row(line)
    return nil unless line.strip.start_with?("|")

    line.strip.split("|")[1..-2]&.map(&:strip)
  end

  def separator?(cells) = cells.all? { |c| c.match?(/\A:?-+:?\z/) }

  def build_row(cells)
    section    = cells[0]
    type       = cells[1]&.downcase
    slug, path = extract_link(cells[2])
    return nil unless slug

    Row.new(
      section: section,
      type:    type,
      slug:    slug,
      path:    path,
      title:   cells[3],
      stage:   cells[4]
    )
  end

  def extract_link(cell)
    m = cell&.match(/\[(?<label>[^\]]*)\]\((?<path>[^)]+)\)/)
    return [nil, nil] unless m

    [m[:label], m[:path]]
  end
end

class Meta
  attr_reader :title, :authors, :abstract

  def initialize(meta_path)
    raw = meta_path.read
    if raw.start_with?("---\n")
      _, frontmatter, body = raw.split(/^---\n/, 3)
      data      = YAML.safe_load(frontmatter)
      @title    = data["title"]
      @authors  = data["authors"] || []
      @abstract = body.strip
    else
      @title    = ""
      @authors  = []
      @abstract = raw.strip
    end
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# Builder — orchestrates assembly + compilation
# ─────────────────────────────────────────────────────────────────────────────

class Builder
  # Natbib options must be \PassOptionsToPackage'd BEFORE \usepackage{neurips_2026}
  # since the sty loads natbib internally. Injected at a different splice point
  # than PREAMBLE_ADDITIONS (which lands right before \begin{document}).
  CITATION_OPTIONS = <<~TEX.freeze
    % Bracketed-superscript numeric citations per AUTHORING.md §2.3.
    \\PassOptionsToPackage{numbers,super,sort&compress}{natbib}
  TEX

  PREAMBLE_ADDITIONS = <<~TEX.freeze
    % Lualatex-native Unicode font handling. Replaces the implicit Nimbus
    % Roman setup pulled in by the NeurIPS sty's \\usepackage{times}, which
    % is missing em-dash, en-dash, Ł, Č, and other glyphs. TeX Gyre Termes
    % is the open-source Times-equivalent with full Unicode coverage —
    % keeps the NeurIPS Times look while rendering everything in our source.
    \\usepackage{fontspec}
    \\setmainfont{TeX Gyre Termes}

    \\usepackage{amsmath}
    \\usepackage{amssymb}
    \\usepackage{amsthm}
    \\usepackage{cleveref}

    % Hyperref boxes off — visually quieter prose; reviewers see plain text
    % rather than colored frames around every \\Cref / \\cite / footnote.
    \\hypersetup{hidelinks}

    % natbib-super defaults: \\NAT@open / \\NAT@close are empty (no brackets),
    % \\NAT@super@kern adds visible kerning inside what brackets do exist.
    % Override all three so \\cite{} renders bracketed-superscript ⁽¹⁾ form
    % per REFS-AND-CITATIONS.md §3.4, and the kerning isn't visible as a
    % space between the bracket and the digit.
    \\makeatletter
    \\def\\NAT@open{[}
    \\def\\NAT@close{]}
    \\def\\NAT@super@kern{}
    \\makeatother

    % Custom \\citet so narrative cites render `Author Year⁽N⁾` instead of
    % natbib-super default `Author [N]` (which drops the year). Uses \\citep
    % directly so the bracket / kerning behavior matches the cite form.
    \\renewcommand{\\citet}[1]{\\citeauthor{#1}~\\citeyear{#1}\\citep{#1}}

    \\bibliographystyle{unsrtnat}

    \\newtheorem{theorem}{Theorem}[section]
    \\newtheorem{lemma}[theorem]{Lemma}
    \\newtheorem{corollary}[theorem]{Corollary}
    \\newtheorem{proposition}[theorem]{Proposition}
    \\newtheorem{conjecture}[theorem]{Conjecture}
    \\newtheorem{claim}[theorem]{Claim}
    \\newtheorem{hypothesis}[theorem]{Hypothesis}

    \\theoremstyle{definition}
    \\newtheorem{definition}[theorem]{Definition}

    \\theoremstyle{remark}
    \\newtheorem{remark}[theorem]{Remark}

    \\crefname{theorem}{Theorem}{Theorems}
    \\crefname{lemma}{Lemma}{Lemmas}
    \\crefname{corollary}{Corollary}{Corollaries}
    \\crefname{proposition}{Proposition}{Propositions}
    \\crefname{definition}{Definition}{Definitions}
    \\crefname{remark}{Remark}{Remarks}
    \\crefname{table}{Table}{Tables}
    \\crefname{figure}{Figure}{Figures}
    \\crefname{equation}{Equation}{Equations}
    \\crefname{section}{Section}{Sections}
  TEX

  def initialize(paper_dir, manifest_stem)
    @paper_dir     = (ROOT / paper_dir).expand_path
    @manifest_stem = manifest_stem
    @out_dir       = @paper_dir / "out"
    @lint_findings = []
  end

  def call
    raise "paper dir not found: #{@paper_dir}" unless @paper_dir.directory?

    meta     = Meta.new(@paper_dir / "meta.md")
    manifest = Manifest.new(@paper_dir / "OUT.#{@manifest_stem}.md")

    body_tex = assemble_body(manifest)
    full_tex = render_template(meta, body_tex)

    FileUtils.mkdir_p(@out_dir)
    tex_path = @out_dir / "#{@manifest_stem}.tex"
    tex_path.write(full_tex)

    compile_pdf(tex_path)
    report_lint
    pdf_path = @out_dir / "#{@manifest_stem}.pdf"
    puts "✓ #{pdf_path.relative_path_from(ROOT)}"
  end

  private

  def assemble_body(manifest)
    body         = +""
    appendix_set = false

    manifest.rows.each do |row|
      if row.type == "appendix" && !appendix_set
        body << "\n\\appendix\n\n"
        appendix_set = true
      end
      body << "\n\\newpage\n" if row.type == "checklist"
      body << if row.type == "bibliography"
                "\n\\bibliography{refs}\n\n"
              else
                render_segment(row)
              end
    end
    body
  end

  def render_segment(row)
    src_path = @paper_dir / row.path
    raise "segment not found: #{src_path}" unless src_path.exist?

    content = src_path.read
    lint_anonymization(content, row.path)
    if src_path.extname == ".tex"
      "#{content}\n"
    else
      content       = preprocess_anchored_equations(content)
      doc           = Kramdown::Document.new(content, input: "NeurIPS")
      out, warnings = doc.to_neurips
      warnings.each { |w| @lint_findings << "#{row.path}: #{w}" }
      out
    end
  end

  # PIPELINE-TODO §B4 / §B5 — scan segment source against refs/deny-list.yml
  # for anonymization vocabulary (Personal / Framework proper-nouns / ELI
  # names) plus self-cite DOIs (ASF Zenodo). Surfaces as build-time warnings;
  # `bin/refs lint` covers the bib-side independently. Per AUTHORING §3.5
  # critical exception, working notes inside spikes/ and _archive/ can use
  # internal terminology — the lint runs on segment source consumed by the
  # build, which only includes what the manifest actually assembles.
  def lint_anonymization(text, source_path)
    @deny_list ||= load_deny_list
    return unless @deny_list

    @deny_list["dois"]&.each do |doi|
      next unless text.include?(doi)

      @lint_findings << "#{source_path}: deny-listed DOI present: #{doi} (AUTHORING §3.5 — ASF self-cite is double-blind violation)"
    end

    @deny_list["authors"]&.each do |surname|
      next unless text.match?(/\b#{Regexp.escape(surname)}\b/)

      @lint_findings << "#{source_path}: self-cite-flag surname '#{surname}' present (verify third-person framing)"
    end

    @deny_list["proper_nouns"]&.each do |name|
      next unless text.match?(/\b#{Regexp.escape(name)}\b/)

      @lint_findings << "#{source_path}: anonymization vocab '#{name}' present (AUTHORING §3.5 — must not appear in submitted PDF)"
    end
  end

  def load_deny_list
    path = ROOT / "refs" / "deny-list.yml"
    return nil unless path.exist?

    YAML.safe_load_file(path)
  end

  # AUTHORING §1.7 — anchored equations are the convention (replacing manual
  # \tag{N}). Detect `$$ ... $$ ^eq-name` and rewrite at source-prep time as
  # `\begin{equation} ... \label{eq-name} \end{equation}` (which IS numbered,
  # unlike kramdown's default \[...\] for $$...$$ which is unnumbered).
  # Multi-line `\begin{aligned}...\end{aligned}` inside `$$...$$` becomes
  # `\begin{align}...\end{align}` (also numbered, with a label on the first row).
  def preprocess_anchored_equations(text)
    text.gsub(/\$\$(.*?)\$\$[ \t]*\^([\w-]+)/m) do
      inner     = Regexp.last_match(1).strip
      anchor    = Regexp.last_match(2)
      rewritten =
        if inner.include?("\\begin{aligned}")
          inner
            .sub("\\begin{aligned}", "\\begin{align}\n\\label{#{anchor}}")
            .sub("\\end{aligned}", "\\end{align}")
        else
          "\\begin{equation}\n#{inner}\n\\label{#{anchor}}\n\\end{equation}"
        end
      # Wrap in nomarkdown so kramdown passes through verbatim — math content
      # contains `^*`, `\|`, `*` etc. that kramdown would otherwise interpret
      # as markdown formatting once $$...$$ math-mode protection is gone.
      "\n{::nomarkdown}\n#{rewritten}\n{:/nomarkdown}\n"
    end
  end

  def render_template(meta, body_tex)
    template = TEMPLATE.read

    # Replace title
    template = template.sub(/\\title\{[^}]*\}/) { "\\title{#{meta.title}}" }

    # Replace author block (multi-line; from \author{ to its closing })
    template = template.sub(/\\author\{.*?\n\}\n/m) { "#{render_author_block(meta)}\n" }

    # Replace abstract
    template = template.sub(/\\begin\{abstract\}.*?\\end\{abstract\}/m) do
      "\\begin{abstract}\n#{meta.abstract}\n\\end{abstract}"
    end

    # Citation options BEFORE \usepackage{neurips_2026} (sty loads natbib internally,
    # so the options must be passed before the sty is loaded).
    template = template.sub("\\usepackage{neurips_2026}") do
      "#{CITATION_OPTIONS}\\usepackage{neurips_2026}"
    end

    # Other preamble additions (theorem envs + cleveref + hidelinks + \citet redef)
    # right before \begin{document}
    template = template.sub("\\begin{document}") { "#{PREAMBLE_ADDITIONS}\n\\begin{document}" }

    # Replace body: from after \begin{abstract}...\end{abstract} to \end{document}.
    # Block form is mandatory — body_tex contains literal backslashes (\\, \&,
    # \emph{...}) that String#sub's replacement-string interpretation would
    # otherwise consume as backreferences/escapes.
    template.sub(/(\\end\{abstract\}\n).*?(\\end\{document\})/m) do
      "#{Regexp.last_match(1)}\n#{body_tex}\n#{Regexp.last_match(2)}"
    end
  end

  def render_author_block(meta)
    lines = ["\\author{%"]
    meta.authors.each_with_index do |a, i|
      lines << "  \\And" if i.positive?
      lines << "  #{a['name']} \\\\"
      lines << "  #{a['affiliation']} \\\\" if a["affiliation"]
      lines << "  \\texttt{#{a['email']}} \\\\" if a["email"]
    end
    lines << "}"
    lines.join("\n")
  end

  def compile_pdf(tex_path)
    env = {
      "TEXINPUTS" => "#{COMMON_DIR}:#{@paper_dir}:",
      "BIBINPUTS" => "#{@paper_dir}:"
    }
    lualatex_cmd = [
      "lualatex",
      "-interaction=nonstopmode",
      "-halt-on-error",
      "-output-directory=#{@out_dir}",
      tex_path.to_s
    ]
    bibtex_cmd = ["bibtex", tex_path.basename(".tex").to_s]

    # lualatex → bibtex → lualatex → lualatex resolves \cite{} + \Cref{}
    # cross-references on the third pass; standard latex bibliography dance.
    run_compile_step(env, lualatex_cmd, "lualatex (pass 1)")
    run_compile_step(env, bibtex_cmd,   "bibtex", allow_fail: true)
    run_compile_step(env, lualatex_cmd, "lualatex (pass 2)")
    run_compile_step(env, lualatex_cmd, "lualatex (pass 3)")
  end

  def run_compile_step(env, cmd, label, allow_fail: false)
    out, status = Open3.capture2e(env, *cmd, chdir: @out_dir.to_s)
    return if status.success? || allow_fail

    tail = out.lines.last(40).join
    raise "#{label} failed:\n#{tail}"
  end

  def report_lint
    return if @lint_findings.empty?

    warn "── Lint findings (#{@lint_findings.size}) ──"
    @lint_findings.each { |f| warn "  #{f.inspect}" }
  end
end

# Wire up the converter so `doc.to_neurips` works (kramdown's auto-method
# generation expects the converter to be registered via `convert(method_name)`).
class Kramdown::Document
  def to_neurips
    output = Kramdown::Converter::NeurIPS.convert(@root, @options)
    output.is_a?(Array) ? output : [output, []]
  end
end

# ─────────────────────────────────────────────────────────────────────────────
# CLI entry
# ─────────────────────────────────────────────────────────────────────────────

if $PROGRAM_NAME == __FILE__
  if ARGV.empty?
    warn "usage: bin/build <paper-dir> [manifest-stem]"
    exit 1
  end
  paper_dir     = ARGV[0]
  manifest_stem = ARGV[1] || "test"
  Builder.new(paper_dir, manifest_stem).call
end
